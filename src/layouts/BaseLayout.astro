---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import SpaceChatbot from '../components/SpaceChatbot.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  waMessage?: string;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, waMessage, jsonLd = [], noindex = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/img/logo.png', Astro.site);
const fullTitle = title.includes('Desquin') ? title : `${title} · Desquin`;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': 'https://desquin.com/#organization',
  name: 'Desquin',
  alternateName: 'Desquin Software',
  url: 'https://desquin.com',
  logo: 'https://desquin.com/img/logo.png',
  image: 'https://desquin.com/img/logo.png',
  description: 'Desarrollo de software, automatizaciones, servidores y bases de datos a la medida, con atención remota para cualquier ubicación.',
  priceRange: '$$',
  areaServed: 'CO',
  address: {
    '@type': 'PostalAddress',
    addressRegion: 'Antioquia',
    addressCountry: 'CO',
  },
  founder: {
    '@type': 'Person',
    name: 'Kevin Quintero',
    jobTitle: 'Ingeniero de Sistemas',
  },
  sameAs: [
    'https://github.com/kevinq01',
    'https://www.linkedin.com/in/kevin-quintero-843h/',
    'https://www.instagram.com/kevin_qh123/',
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+57-304-673-8074',
    contactType: 'customer service',
    areaServed: 'CO',
    availableLanguage: ['es'],
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servicios Desquin',
    itemListElement: [
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Desarrollo web', description: 'Sitios corporativos, portafolios, tiendas en línea y aplicaciones web a medida.' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Software de gestión de excursiones', description: 'Plataformas para agencias de viajes y colegios: contratos, estudiantes, pagos y acomodaciones.' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Software de gestión de reservas', description: 'Plataformas de reservas para agencias de viajes: cotizaciones, pagos, proveedores y comisiones.' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Automatizaciones', description: 'Integraciones, notificaciones y flujos de trabajo automáticos.' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Servidores e infraestructura', description: 'Configuración, despliegue, monitoreo y mantenimiento de servidores.' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Bases de datos', description: 'Diseño, optimización y migración de bases de datos.' } },
    ],
  },
};
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href="/img/logo.png" />
  <link rel="apple-touch-icon" href="/img/logo.png" />
  <link rel="canonical" href={canonicalURL} />
  <meta name="theme-color" content="#09090b" />

  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Desquin" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1080" />
  <meta property="og:image:height" content="1080" />
  <meta property="og:locale" content="es_CO" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Fuentes: alojadas en /fonts (ver @font-face en global.css). Se precargan
       las dos que pintan el primer texto visible (cuerpo y títulos). -->
  <link rel="preload" href="/fonts/plus-jakarta-sans-fdb05bf0.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/general-sans-700.woff2" as="font" type="font/woff2" crossorigin />

  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  {jsonLd.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}
  <noscript><style>.reveal{opacity:1!important;transform:none!important}</style></noscript>
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
  <WhatsAppFloat message={waMessage} />
  <SpaceChatbot />

  <script>
    // Fondo de estrellas: estáticas y de brillo variable (unas más tenues que
    // otras). Sin parpadeo: son 3 capas con box-shadow (una por tamaño) en vez
    // de 70-160 nodos animados, así el navegador no recompone nada al hacer
    // scroll y no hay animación continua que consuma GPU/batería.
    const starContainer = document.createElement('div');
    starContainer.className = 'stars';
    const drawStars = () => {
      // screen.* evita huecos cuando la barra de iOS cambia innerHeight.
      const w = Math.max(window.innerWidth, window.screen.width || 0);
      const h = Math.max(window.innerHeight, window.screen.height || 0);
      const count = Math.min(160, Math.max(70, Math.round(window.innerWidth / 10)));
      const layers: string[][] = [[], [], []];
      for (let i = 0; i < count; i++) {
        const x = Math.round(Math.random() * w);
        const y = Math.round(Math.random() * h);
        const alpha = (0.25 + Math.random() * 0.75).toFixed(2);
        // Más estrellas pequeñas que grandes (1px, 2px, 3px).
        const r = Math.random();
        layers[r < 0.55 ? 0 : r < 0.9 ? 1 : 2].push(`${x}px ${y}px rgba(255,255,255,${alpha})`);
      }
      starContainer.replaceChildren(...layers.map((shadows, n) => {
        const el = document.createElement('div');
        el.className = `star-layer star-layer-${n + 1}`;
        el.style.boxShadow = shadows.join(',');
        return el;
      }));
    };
    drawStars();
    document.body.prepend(starContainer);
    // Solo se regenera si cambia el ANCHO (rotación); no por la barra de iOS.
    let lastW = window.innerWidth;
    window.addEventListener('resize', () => {
      if (window.innerWidth !== lastW) { lastW = window.innerWidth; drawStars(); }
    }, { passive: true });
  </script>

  <script>
    // Efecto spotlight en tarjetas: brillo morado que sigue al cursor.
    let spotRaf = null;
    document.addEventListener('mousemove', (e) => {
      const card = e.target?.closest?.('.glass-panel');
      if (!card || spotRaf) return;
      spotRaf = requestAnimationFrame(() => {
        const rect = card.getBoundingClientRect();
        card.style.setProperty('--spot-x', `${e.clientX - rect.left}px`);
        card.style.setProperty('--spot-y', `${e.clientY - rect.top}px`);
        spotRaf = null;
      });
    });
  </script>

  <script>
    // Revela los .reveal al entrar en pantalla, sin dejar ninguno invisible:
    //  - los que ya pasaron por encima (scroll rápido/inercia en iOS: el
    //    observer entrega solo el último estado y el elemento ya está arriba)
    //    se revelan igual;
    //  - sin IntersectionObserver, o si no responde, todo se revela;
    //  - al volver con el botón "atrás" (bfcache) se vuelve a comprobar.
    const els = [...document.querySelectorAll('.reveal')];
    const show = (el) => el.classList.add('is-visible');
    const showAll = () => els.forEach(show);
    if (!('IntersectionObserver' in window)) {
      showAll();
    } else {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting || entry.boundingClientRect.top < 0) {
            show(entry.target);
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0, rootMargin: '0px 0px -8% 0px' });
      els.forEach((el) => io.observe(el));
      // Red de seguridad: revisa por geometría lo que el observer no reveló.
      const sweep = () => {
        const vh = window.innerHeight;
        els.forEach((el) => {
          if (!el.classList.contains('is-visible') && el.getBoundingClientRect().top < vh) show(el);
        });
      };
      let sweepTimer: ReturnType<typeof setTimeout>;
      window.addEventListener('scroll', () => { clearTimeout(sweepTimer); sweepTimer = setTimeout(sweep, 150); }, { passive: true });
      window.addEventListener('pageshow', sweep);
      setTimeout(sweep, 1200);
    }
  </script>

  <script>
    // Pausa las animaciones infinitas de lo que no se ve (marquee, astronauta,
    // acentos): sin trabajo de animación fuera de pantalla.
    if ('IntersectionObserver' in window) {
      const pauser = new IntersectionObserver((entries) => {
        entries.forEach((e) => e.target.classList.toggle('anim-paused', !e.isIntersecting));
      }, { rootMargin: '100px' });
      document.querySelectorAll('.tech-marquee-track, .astronaut-frame, .space-accent').forEach((el) => pauser.observe(el));
    }
  </script>
</body>
</html>
