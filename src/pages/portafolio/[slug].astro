---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TechIcon from '../../components/TechIcon.astro';
import ProjectGallery from '../../components/ProjectGallery.astro';
import FlowDiagram from '../../components/FlowDiagram.astro';
import { projectGallery } from '../../lib/project-images';
import { SHOW_LIVE_LINKS } from '../../lib/site';
import DemoAccess from '../../components/DemoAccess.astro';
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';

export async function getStaticPaths() {
  const proyectos = await getCollection('proyectos');
  return proyectos.map((p) => ({
    params: { slug: p.id },
    props: { entry: p },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { name, excerpt, statusLabel, tech, liveUrl, ctaLabel, demoLinks, flow, flowBranch, whatsappMessage } = entry.data;
const gallery = projectGallery(entry.id, name, entry.data.gallery);
const waHref = `https://wa.me/573046738074?text=${encodeURIComponent(whatsappMessage)}`;

const { seoTitle, faq, status } = entry.data;
const pageUrl = `https://desquin.com/portafolio/${entry.id}`;
const description = excerpt.length > 160 ? `${excerpt.slice(0, 157)}...` : excerpt;
// Versión optimizada (WebP 1200px) para el JSON-LD: usar cover.src apuntaba al PNG
// original (hasta 2,3 MB) y obligaba a publicarlo en el build.
const cover = gallery[0]?.src
  ? await getImage({ src: gallery[0].src, width: Math.min(gallery[0].src.width, 1200), format: 'webp', quality: 85 })
  : undefined;

// Datos estructurados: SoftwareApplication con oferta (disponible para la venta)
// y FAQPage cuando el proyecto declara preguntas frecuentes.
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name,
  description: excerpt,
  url: pageUrl,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  inLanguage: 'es',
  author: { '@id': 'https://desquin.com/#organization' },
  publisher: { '@id': 'https://desquin.com/#organization' },
  ...(cover ? { image: new URL(cover.src, Astro.site).href } : {}),
  ...(status === 'disponible'
    ? {
        offers: {
          '@type': 'Offer',
          availability: 'https://schema.org/InStock',
          priceCurrency: 'COP', // sin "price": se cotiza a la medida; agregarlo aquí si algún día hay precio fijo
          seller: { '@id': 'https://desquin.com/#organization' },
          url: pageUrl,
        },
      }
    : {}),
};
const faqSchema = faq?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((f: { q: string; a: string }) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://desquin.com/' },
    { '@type': 'ListItem', position: 2, name: 'Proyectos', item: 'https://desquin.com/portafolio' },
    { '@type': 'ListItem', position: 3, name, item: `https://desquin.com/portafolio/${entry.id}` },
  ],
};
---
<BaseLayout
  title={seoTitle ?? name}
  description={description}
  waMessage={whatsappMessage}
  jsonLd={[breadcrumbSchema, softwareSchema, ...(faqSchema ? [faqSchema] : [])]}
>
  <section class="section" style="padding-top:48px;">
    <div class="container" style="max-width: 1020px;">
      <nav class="breadcrumb" aria-label="Ruta de navegación">
        <a href="/">Inicio</a><span>/</span>
        <a href="/portafolio">Proyectos</a><span>/</span>
        <span>{name}</span>
      </nav>

      <div style="margin-bottom:32px;">
        <ProjectGallery name={name} items={gallery} />
      </div>

      <div class="split-2" style="grid-template-columns: 1.3fr 1fr; align-items:start;">
        <div>
          <h1 style="font-size:clamp(2.2rem,5vw,3rem);">{name}</h1>
          <p class="lead">{excerpt}</p>

          {flow && <FlowDiagram steps={flow} branch={flowBranch} />}

          <div class="glass-panel reveal" style="padding:28px; margin-top:8px;">
            <Content />
          </div>

          {faq && faq.length > 0 && (
            <div class="glass-panel reveal" style="padding:28px; margin-top:24px;">
              <h2 style="font-size:1.4rem; margin-bottom:16px;">Preguntas frecuentes</h2>
              {faq.map((f: { q: string; a: string }) => (
                <details style="padding:12px 0; border-top:1px solid rgba(255,255,255,0.08);">
                  <summary style="cursor:pointer; font-weight:600;">{f.q}</summary>
                  <p style="margin-top:8px;">{f.a}</p>
                </details>
              ))}
            </div>
          )}
        </div>

        <div class="glass-panel reveal" style="padding:28px; position:sticky; top:96px;">
          <span class="eyebrow" style="margin-bottom:14px; display:inline-flex;">Stack técnico</span>
          <div class="project-tags" style="margin-bottom:24px;">
            {tech.map((t) => <span class="tech-tag"><TechIcon name={t} size={15} />{t}</span>)}
          </div>

          <div style="display:flex; flex-direction:column; gap:10px;">
            {SHOW_LIVE_LINKS && (demoLinks && demoLinks.length > 0 ? (
              <DemoAccess links={demoLinks} triggerLabel={ctaLabel ?? 'Ver sitio en vivo'} />
            ) : liveUrl ? (
              <a href={liveUrl} target="_blank" rel="noopener" class="btn btn-ghost" style="justify-content:center;">{ctaLabel ?? 'Ver sitio en vivo'}</a>
            ) : ctaLabel && (
              <span class="btn btn-ghost btn-pending" style="justify-content:center;">{ctaLabel} <em>próximamente</em></span>
            ))}
            <a href={waHref} target="_blank" rel="noopener" class="btn btn-whatsapp" style="justify-content:center;">Contactar por este proyecto</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
