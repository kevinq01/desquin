---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TechIcon from '../../components/TechIcon.astro';
import ProjectGallery from '../../components/ProjectGallery.astro';
import FlowDiagram from '../../components/FlowDiagram.astro';
import { projectGallery } from '../../lib/project-images';
import { SHOW_LIVE_LINKS } from '../../lib/site';
import DemoAccess from '../../components/DemoAccess.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const proyectos = await getCollection('proyectos');
  return proyectos.map((p) => ({
    params: { slug: p.id },
    props: { entry: p },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { name, excerpt, statusLabel, tech, liveUrl, ctaLabel, demoLinks, flow, flowBranch, whatsappMessage } = entry.data;
const gallery = projectGallery(entry.id, name, entry.data.gallery);
const waHref = `https://wa.me/573046738074?text=${encodeURIComponent(whatsappMessage)}`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://desquin.vercel.app/' },
    { '@type': 'ListItem', position: 2, name: 'Proyectos', item: 'https://desquin.vercel.app/portafolio' },
    { '@type': 'ListItem', position: 3, name, item: `https://desquin.vercel.app/portafolio/${entry.id}` },
  ],
};
---
<BaseLayout title={name} description={excerpt} waMessage={whatsappMessage} jsonLd={[breadcrumbSchema]}>
  <section class="section" style="padding-top:48px;">
    <div class="container" style="max-width: 1020px;">
      <nav class="breadcrumb" aria-label="Ruta de navegación">
        <a href="/">Inicio</a><span>/</span>
        <a href="/portafolio">Proyectos</a><span>/</span>
        <span>{name}</span>
      </nav>

      <div style="margin-bottom:32px;">
        <ProjectGallery name={name} items={gallery} />
      </div>

      <div class="split-2" style="grid-template-columns: 1.3fr 1fr; align-items:start;">
        <div>
          <h1 style="font-size:clamp(2.2rem,5vw,3rem);">{name}</h1>
          <p class="lead">{excerpt}</p>

          {flow && <FlowDiagram steps={flow} branch={flowBranch} />}

          <div class="glass-panel reveal" style="padding:28px; margin-top:8px;">
            <Content />
          </div>
        </div>

        <div class="glass-panel reveal" style="padding:28px; position:sticky; top:96px;">
          <span class="eyebrow" style="margin-bottom:14px; display:inline-flex;">Stack técnico</span>
          <div class="project-tags" style="margin-bottom:24px;">
            {tech.map((t) => <span class="tech-tag"><TechIcon name={t} size={15} />{t}</span>)}
          </div>

          <div style="display:flex; flex-direction:column; gap:10px;">
            {SHOW_LIVE_LINKS && (demoLinks && demoLinks.length > 0 ? (
              <DemoAccess links={demoLinks} triggerLabel={ctaLabel ?? 'Ver sitio en vivo'} />
            ) : liveUrl ? (
              <a href={liveUrl} target="_blank" rel="noopener" class="btn btn-ghost" style="justify-content:center;">{ctaLabel ?? 'Ver sitio en vivo'}</a>
            ) : ctaLabel && (
              <span class="btn btn-ghost btn-pending" style="justify-content:center;">{ctaLabel} <em>próximamente</em></span>
            ))}
            <a href={waHref} target="_blank" rel="noopener" class="btn btn-whatsapp" style="justify-content:center;">Contactar por este proyecto</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
