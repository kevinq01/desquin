---
import BaseLayout from "../layouts/BaseLayout.astro";
import SpaceAccent from "../components/SpaceAccent.astro";

const servicios = [
    {
        name: "Desarrollo web",
        desc: "Sitios corporativos, portafolios, tiendas en línea, sistemas administrativos y aplicaciones web a medida.",
        items: [
            "Sitios institucionales y de marca",
            "Tiendas en línea (e-commerce)",
            "Sistemas de gestión y paneles multi-rol",
            "Optimización de velocidad y SEO técnico",
        ],
    },
    {
        name: "Automatizaciones",
        desc: "Tareas repetitivas convertidas en procesos automáticos que corren solos.",
        items: [
            "Notificaciones y correos automáticos",
            "Integraciones de pago (PSE, MercadoPago)",
            "Integraciones entre sistemas y APIs",
            "Reportes y flujos de datos automáticos",
        ],
    },
    {
        name: "Servidores e infraestructura",
        desc: "Que tu sistema esté disponible cuando tus clientes lo necesitan.",
        items: [
            "Configuración y despliegue de servidores",
            "Migraciones sin tiempo de inactividad",
            "Monitoreo y mantenimiento",
            "Copias de seguridad y planes de recuperación",
        ],
    },
    {
        name: "Bases de datos",
        desc: "Información ordenada, rápida de consultar y lista para crecer.",
        items: [
            "Diseño de bases de datos desde cero",
            "Optimización de consultas lentas",
            "Migración entre motores",
            "Reportes y paneles de datos",
        ],
    },
];

const serviceSchema = {
    "@context": "https://schema.org",
    "@type": "ItemList",
    itemListElement: servicios.map((s, i) => ({
        "@type": "ListItem",
        position: i + 1,
        item: {
            "@type": "Service",
            name: s.name,
            description: s.desc,
            provider: { "@type": "ProfessionalService", name: "Desquin" },
            areaServed: "CO",
        },
    })),
};

const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        {
            "@type": "ListItem",
            position: 1,
            name: "Inicio",
            item: "https://desquin.com/",
        },
        {
            "@type": "ListItem",
            position: 2,
            name: "Servicios",
            item: "https://desquin.com/servicios",
        },
    ],
};
---

<BaseLayout
    title="Desarrollo de software a la medida"
    description="Desarrollo de software a la medida, automatizaciones, servidores y bases de datos para tu negocio en Colombia, con presupuesto claro desde el inicio."
    jsonLd={[serviceSchema, breadcrumbSchema]}
>
    <section class="section" style="padding-top:56px;">
        <div class="container" style="position:relative;">
            <SpaceAccent variant="planet" class="space-accent-page" />
            <nav class="breadcrumb" aria-label="Ruta de navegación">
                <a href="/">Inicio</a><span>/</span>
                <span>Servicios</span>
            </nav>
            <div class="section-head">
                <span class="eyebrow">Servicios</span>
                <h1>Desarrollo de software a la medida</h1>
                <p class="lead">
                    Cuatro frentes, un solo equipo: desde la primera línea de
                    código hasta el servidor donde vive tu sistema. Sin paquetes
                    cerrados — cada proyecto se cotiza según lo que realmente
                    necesitas.
                </p>
            </div>

            <h2 class="sr-only">Catálogo de servicios</h2>
            <div class="grid-2">
                {
                    servicios.map((s, i) => (
                        <div
                            class="glass-panel service-card reveal"
                            style={`transition-delay:${i * 80}ms`}
                        >
                            <span class="index">0{i + 1}</span>
                            <h3>{s.name}</h3>
                            <p>{s.desc}</p>
                            <ul>
                                {s.items.map((item) => (
                                    <li>{item}</li>
                                ))}
                            </ul>
                        </div>
                    ))
                }
            </div>

            <div class="cta-banner glass-panel reveal" style="margin-top:56px;">
                <div>
                    <h3 style="margin-bottom:6px;">
                        ¿No sabes cuál servicio necesitas?
                    </h3>
                    <p style="margin:0;">
                        Cuéntanos tu problema, no la solución. Nosotros te
                        decimos cómo resolverlo.
                    </p>
                </div>
                <a
                    href="https://wa.me/573046738074?text=Hola%2C%20no%20estoy%20seguro%20qu%C3%A9%20servicio%20necesito%2C%20%C2%BFme%20pueden%20orientar%3F"
                    target="_blank"
                    rel="noopener"
                    class="btn btn-whatsapp"
                >
                    Preguntar por WhatsApp
                </a>
            </div>
        </div>
    </section>
</BaseLayout>
