---
import BaseLayout from "../layouts/BaseLayout.astro";
import SpaceAccent from "../components/SpaceAccent.astro";

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{
			"@type": "ListItem",
			position: 1,
			name: "Inicio",
			item: "https://desquin.com/",
		},
		{
			"@type": "ListItem",
			position: 2,
			name: "Contacto",
			item: "https://desquin.com/contacto",
		},
	],
};
---

<BaseLayout
	title="Contacto — Cotiza tu proyecto de software"
	description="¿Tienes un proyecto de software, una automatización o necesitas mejorar tu infraestructura? Cuéntanos qué necesitas y hablemos."
	jsonLd={[breadcrumbSchema]}
>
	<section class="section" style="padding-top:56px;">
		<div class="container" style="position:relative;">
			<SpaceAccent variant="star" class="space-accent-page" />
			<nav class="breadcrumb" aria-label="Ruta de navegación">
				<a href="/">Inicio</a><span>/</span>
				<span>Contacto</span>
			</nav>
			<div class="section-head">
				<span class="eyebrow">Contacto</span>
				<h1>Hablemos de tu proyecto</h1>
				<p class="lead">
					Cuéntanos qué tienes en mente. Puedes escribirnos por
					WhatsApp o dejarnos un mensaje y nos pondremos en contacto
					contigo.
				</p>
			</div>

			<div class="contact-grid">
				<div class="contact-info-list reveal">
					<a
						href="https://wa.me/573046738074?text=Hola%2C%20quiero%20hablar%20sobre%20un%20proyecto"
						target="_blank"
						rel="noopener"
						class="glass-panel contact-info-item"
						style="padding:20px; text-decoration:none;"
					>
						<span class="icon">
							<svg
								width="20"
								height="20"
								viewBox="0 0 24 24"
								fill="currentColor"
								><path
									d="M17.47 14.38c-.29-.15-1.73-.85-2-.95-.27-.1-.46-.15-.66.15-.2.29-.76.95-.93 1.14-.17.2-.34.22-.63.07-.29-.15-1.22-.45-2.32-1.43-.86-.76-1.44-1.7-1.6-1.99-.17-.29-.02-.44.13-.59.13-.13.29-.34.44-.51.15-.17.2-.29.29-.49.1-.2.05-.37-.02-.51-.07-.15-.66-1.59-.9-2.18-.24-.57-.48-.49-.66-.5h-.56c-.2 0-.51.07-.78.37-.27.29-1.02 1-1.02 2.44s1.05 2.83 1.19 3.03c.15.2 2.07 3.16 5.02 4.43.7.3 1.25.48 1.68.62.7.22 1.34.19 1.85.11.56-.08 1.73-.71 1.98-1.39.24-.68.24-1.27.17-1.39-.07-.12-.27-.2-.56-.34ZM12.02 2.5C6.76 2.5 2.5 6.75 2.5 12c0 1.77.49 3.44 1.34 4.87L2.5 21.5l4.76-1.25a9.47 9.47 0 0 0 4.76 1.28c5.26 0 9.52-4.25 9.52-9.5S17.28 2.5 12.02 2.5Z"
								></path></svg
							>
						</span>
						<div>
							<h3 style="margin-bottom:2px; font-size:1.05rem;">
								WhatsApp
							</h3>
							<p style="margin:0;">+57 304 673 8074</p>
						</div>
					</a>

					<a
						href="mailto:andreskevin843@gmail.com"
						class="glass-panel contact-info-item"
						style="padding:20px; text-decoration:none;"
					>
						<span class="icon">
							<svg
								width="20"
								height="20"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								><path d="M4 4h16v16H4z" stroke-linejoin="round"
								></path><path
									d="m4 6 8 7 8-7"
									stroke-linejoin="round"></path></svg
							>
						</span>
						<div>
							<h3 style="margin-bottom:2px; font-size:1.05rem;">
								Correo
							</h3>
							<p style="margin:0;">andreskevin843@gmail.com</p>
						</div>
					</a>

					<div
						class="glass-panel contact-info-item"
						style="padding:20px;"
					>
						<span class="icon">
							<svg
								width="20"
								height="20"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								><path
									d="M12 21s-7-5.33-7-11a7 7 0 0 1 14 0c0 5.67-7 11-7 11Z"
								></path><circle cx="12" cy="10" r="2.5"
								></circle></svg
							>
						</span>
						<div>
							<h3 style="margin-bottom:2px; font-size:1.05rem;">
								Ubicación
							</h3>
							<p style="margin:0;">
								Antioquia, Colombia — proyectos de forma remota
							</p>
						</div>
					</div>
				</div>

				<form
					id="contact-form"
					class="glass-panel contact-form reveal"
					action="https://api.web3forms.com/submit"
					method="POST"
				>
					<input
						type="hidden"
						name="access_key"
						value="0ebdd3e2-af89-48af-ad1c-8c917416ef35"
					/>

					<input
						type="hidden"
						name="subject"
						value="Nueva consulta desde Desquin"
					/>

					<div>
						<label for="name">Nombre</label>
						<input
							id="name"
							name="name"
							type="text"
							required
							autocomplete="name"
							placeholder="Tu nombre"
						/>
					</div>

					<div>
						<label for="email">Correo</label>
						<input
							id="email"
							name="email"
							type="email"
							required
							autocomplete="email"
							placeholder="tucorreo@ejemplo.com"
						/>
					</div>

					<div>
						<label for="message">Mensaje</label>
						<textarea
							id="message"
							name="message"
							rows="5"
							required
							placeholder="Cuéntanos qué necesitas"></textarea>
					</div>

					<button
						type="submit"
						class="btn btn-primary"
						id="contact-submit"
					>
						Enviar mensaje
					</button>

					<div
						id="contact-result"
						class="contact-result"
						role="status"
						aria-live="polite"
						hidden
					>
					</div>
				</form>
			</div>
		</div>
	</section>

	<script>
		const form = document.getElementById(
			"contact-form",
		) as HTMLFormElement | null;
		const result = document.getElementById(
			"contact-result",
		) as HTMLDivElement | null;
		const submitButton = document.getElementById(
			"contact-submit",
		) as HTMLButtonElement | null;

		if (form && result && submitButton) {
			form.addEventListener("submit", async (event) => {
				event.preventDefault();

				result.hidden = false;
				result.className = "contact-result is-loading";
				result.textContent = "Enviando mensaje...";
				submitButton.disabled = true;

				try {
					const formData = new FormData(form);

					const response = await fetch(
						"https://api.web3forms.com/submit",
						{
							method: "POST",
							headers: {
								Accept: "application/json",
							},
							body: formData,
						},
					);

					const data = await response.json();

					if (response.ok && data.success) {
						result.className = "contact-result is-success";
						result.textContent =
							"¡Mensaje enviado! Gracias por escribirnos. Nos pondremos en contacto contigo pronto.";

						form.reset();
					} else {
						result.className = "contact-result is-error";
						result.textContent =
							data.message ||
							"No pudimos enviar el mensaje. Inténtalo nuevamente.";
					}
				} catch (error) {
					console.error("Error al enviar el formulario:", error);

					result.className = "contact-result is-error";
					result.textContent =
						"Ocurrió un error al enviar el mensaje. Revisa tu conexión e inténtalo nuevamente.";
				} finally {
					submitButton.disabled = false;
				}
			});
		}
	</script>
</BaseLayout>
