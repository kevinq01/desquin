---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  items?: { src: ImageMetadata; alt: string; caption?: string }[];
}

const { name, items = [] } = Astro.props;
const multiple = items.length > 1;
// Versión grande (hasta 2400px) para la vista ampliada
const full = await Promise.all(
  items.map((it) => getImage({ src: it.src, width: Math.min(it.src.width, 2400), quality: 90 })),
);
---
<section class="pgallery reveal" aria-label={`Galería de ${name}`} data-gallery>
  <h2 class="pgallery-title">Galería</h2>
  {items.length === 0 ? (
    <div class="pgallery-empty">
      <span>Capturas de {name}</span>
      <em>Galería próximamente</em>
    </div>
  ) : (
    <>
      <div class="pgallery-stage">
        {multiple && <button type="button" class="pgallery-nav prev" data-prev aria-label="Imagen anterior">‹</button>}
        <div class="pgallery-track" data-track>
          {items.map((it, i) => (
            <figure class="pgallery-slide" data-slide>
              <button type="button" class="pgallery-zoom" data-zoom aria-label="Ampliar imagen">
                <Image src={it.src} alt={it.alt} widths={[800, 1200, 1600, 2000]} sizes="(max-width: 900px) 100vw, 900px" quality={90} data-full={full[i].src} loading={i === 0 ? 'eager' : 'lazy'} />
              </button>
              {it.caption && <figcaption>{it.caption}</figcaption>}
            </figure>
          ))}
        </div>
        {multiple && <button type="button" class="pgallery-nav next" data-next aria-label="Imagen siguiente">›</button>}
      </div>
      {multiple && (
        <div class="pgallery-thumbs" data-thumbs>
          {items.map((it, i) => (
            <button type="button" class="pgallery-thumb" data-thumb aria-label={`Ver imagen ${i + 1}`}>
              <Image src={it.src} alt="" width={240} height={150} quality={80} loading="lazy" />
            </button>
          ))}
        </div>
      )}
      <dialog class="pgallery-dialog" data-dialog aria-label="Imagen ampliada">
        <button type="button" class="pgallery-close" data-close aria-label="Cerrar">×</button>
        <img data-dialog-img alt="" />
      </dialog>
    </>
  )}
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]');
    if (!track) return;
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const thumbs = [...root.querySelectorAll<HTMLElement>('[data-thumb]')];
    const dialog = root.querySelector<HTMLDialogElement>('[data-dialog]')!;
    const big = root.querySelector<HTMLImageElement>('[data-dialog-img]')!;
    let current = 0;

    const go = (i: number, scroll = true) => {
      current = (i + slides.length) % slides.length;
      if (scroll) track.scrollTo({ left: current * track.clientWidth, behavior: 'smooth' });
      thumbs.forEach((t, n) => t.classList.toggle('is-active', n === current));
    };
    const showBig = () => {
      const img = slides[current].querySelector('img')!;
      big.src = img.dataset.full || img.currentSrc || img.src;
      big.alt = img.alt;
    };

    root.querySelector('[data-prev]')?.addEventListener('click', () => go(current - 1));
    root.querySelector('[data-next]')?.addEventListener('click', () => go(current + 1));
    thumbs.forEach((t, n) => t.addEventListener('click', () => go(n)));

    // Sincroniza miniaturas al deslizar con el dedo
    track.addEventListener('scroll', () => {
      const n = Math.round(track.scrollLeft / track.clientWidth);
      if (n !== current && slides[n]) go(n, false);
    }, { passive: true });

    root.addEventListener('keydown', (e) => {
      if (dialog.open) return;
      if (e.key === 'ArrowLeft') go(current - 1);
      if (e.key === 'ArrowRight') go(current + 1);
    });

    slides.forEach((s, n) => s.querySelector('[data-zoom]')?.addEventListener('click', () => {
      current = n;
      showBig();
      dialog.showModal();
    }));
    dialog.addEventListener('click', () => dialog.close());
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') {
        go(current + (e.key === 'ArrowRight' ? 1 : -1));
        showBig();
      }
    });
    go(0, false);
  });
</script>
