---
// Widget de chat "Agente del espacio".
// Flujo: reglas/palabras clave (src/lib/chatbot-data.ts) -> si no hay coincidencia
// confiable, IA vía /api/chat (api/chat.js) -> si falla, ofrece WhatsApp.
---
<div class="chatbot-root">
  <button
    id="chatbotLauncher"
    class="chatbot-launcher"
    type="button"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="chatbotWindow"
    aria-label="Abrir el agente del espacio"
  >
    <svg class="chatbot-launcher-icon chatbot-icon-open" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="20" cy="20" r="17" fill="#eceafa" />
      <circle cx="20" cy="20" r="13" fill="#a47cff" />
      <circle cx="17" cy="17" r="3.2" fill="#fff" />
      <circle cx="24" cy="19" r="2.4" fill="#fff" opacity="0.85" />
      <path d="M14 25 Q20 30 26 25" stroke="#241c38" stroke-width="2" fill="none" stroke-linecap="round" opacity="0.55" />
    </svg>
    <svg class="chatbot-launcher-icon chatbot-icon-close" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M6 6l12 12M18 6L6 18" stroke="#fff" stroke-width="2.4" stroke-linecap="round" />
    </svg>
  </button>

  <section id="chatbotWindow" class="chatbot-window glass-panel" role="dialog" aria-modal="false" aria-labelledby="chatbotTitle" hidden>
    <header class="chatbot-header">
      <div class="chatbot-header-avatar" aria-hidden="true">
        <svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg">
          <circle cx="20" cy="20" r="17" fill="#eceafa" />
          <circle cx="20" cy="20" r="13" fill="#a47cff" />
          <circle cx="17" cy="17" r="3.2" fill="#fff" />
          <circle cx="24" cy="19" r="2.4" fill="#fff" opacity="0.85" />
        </svg>
      </div>
      <div>
        <p id="chatbotTitle" class="chatbot-title">Agente del espacio</p>
        <p class="chatbot-subtitle">Resolviendo dudas en órbita</p>
      </div>
      <a class="chatbot-wa" id="chatbotWa" href="#" target="_blank" rel="noopener" aria-label="Hablar con una persona por WhatsApp" title="Hablar por WhatsApp">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M17.47 14.38c-.29-.15-1.73-.85-2-.95-.27-.1-.46-.15-.66.15-.2.29-.76.95-.93 1.14-.17.2-.34.22-.63.07-.29-.15-1.22-.45-2.32-1.43-.86-.76-1.44-1.7-1.6-1.99-.17-.29-.02-.44.13-.59.13-.13.29-.34.44-.51.15-.17.2-.29.29-.49.1-.2.05-.37-.02-.51-.07-.15-.66-1.59-.9-2.18-.24-.57-.48-.49-.66-.5h-.56c-.2 0-.51.07-.78.37-.27.29-1.02 1-1.02 2.44s1.05 2.83 1.19 3.03c.15.2 2.07 3.16 5.02 4.43.7.3 1.25.48 1.68.62.7.22 1.34.19 1.85.11.56-.08 1.73-.71 1.98-1.39.24-.68.24-1.27.17-1.39-.07-.12-.27-.2-.56-.34ZM12.02 2.5C6.76 2.5 2.5 6.75 2.5 12c0 1.77.49 3.44 1.34 4.87L2.5 21.5l4.76-1.25a9.47 9.47 0 0 0 4.76 1.28c5.26 0 9.52-4.25 9.52-9.5S17.28 2.5 12.02 2.5Z"/></svg>
      </a>
      <button type="button" class="chatbot-close" aria-label="Cerrar chat">×</button>
    </header>

    <div class="chatbot-log" id="chatbotLog" role="log" aria-live="polite"></div>
    <div class="chatbot-quick-replies" id="chatbotQuickReplies" role="group" aria-label="Preguntas rápidas"></div>

    <form class="chatbot-input-row" id="chatbotForm">
      <label for="chatbotInput" class="sr-only">Escribe tu pregunta</label>
      <input id="chatbotInput" type="text" autocomplete="off" placeholder="Escribe tu pregunta…" />
      <button type="submit" class="chatbot-send" aria-label="Enviar mensaje">➤</button>
    </form>
  </section>
</div>

<script>
  import { resolveAnswer, getAnswerForTopic, getRootQuickReplies, askAI } from '../lib/chatbot-data';
  import type { BotAnswer, QuickReply, ChatTurn } from '../lib/chatbot-data';

  const WHATSAPP_NUMBER = '573046738074';
  const GREETING = 'Hola, soy el agente del espacio de Desquin 🚀. Elige una pregunta o escribe la tuya.';
  const FALLBACK = 'No estoy seguro de cómo responder eso. Mejor cuéntaselo directo al equipo por WhatsApp y te ayudan enseguida.';
  const WA_LABEL = 'Hablar por WhatsApp';

  const launcher = document.getElementById('chatbotLauncher') as HTMLButtonElement | null;
  const win = document.getElementById('chatbotWindow') as HTMLElement | null;
  const log = document.getElementById('chatbotLog') as HTMLElement | null;
  const qrBox = document.getElementById('chatbotQuickReplies') as HTMLElement | null;
  const form = document.getElementById('chatbotForm') as HTMLFormElement | null;
  const input = document.getElementById('chatbotInput') as HTMLInputElement | null;
  const waBtn = document.getElementById('chatbotWa') as HTMLAnchorElement | null;
  const closeBtn = win?.querySelector('.chatbot-close') as HTMLButtonElement | null;

  if (launcher && win && log && qrBox && form && input && closeBtn) {
    let isOpen = false;
    let greeted = false;
    let busy = false;
    let lastUserText = 'Hola, quiero información sobre tus servicios';
    const history: ChatTurn[] = [];

    const waLink = (text: string) => `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(text)}`;
    const waReply: QuickReply = { id: '__whatsapp__', label: WA_LABEL };
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const refreshWaHeader = () => { if (waBtn) waBtn.href = waLink(lastUserText); };
    refreshWaHeader();

    function appendMessage(role: 'bot' | 'user', text: string) {
      const p = document.createElement('p');
      p.className = `chatbot-msg chatbot-msg-${role}`;
      p.textContent = text;
      log!.appendChild(p);
      log!.scrollTop = log!.scrollHeight;
      history.push({ role: role === 'bot' ? 'assistant' : 'user', content: text });
    }

    function showTyping() {
      const p = document.createElement('p');
      p.className = 'chatbot-msg chatbot-msg-bot chatbot-typing';
      p.setAttribute('aria-label', 'El agente está escribiendo');
      p.innerHTML = '<span></span><span></span><span></span>';
      log!.appendChild(p);
      log!.scrollTop = log!.scrollHeight;
      return p;
    }

    function clearQuickReplies() {
      qrBox!.innerHTML = '';
    }

    function renderQuickReplies(items: QuickReply[]) {
      clearQuickReplies();
      items.forEach((item) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = item.id === '__whatsapp__' ? 'chatbot-chip chatbot-chip-wa' : 'chatbot-chip';
        btn.textContent = item.label;
        btn.addEventListener('click', () => onQuickReply(item));
        qrBox!.appendChild(btn);
      });
    }

    /** Muestra "escribiendo…" un tiempo proporcional al texto y luego la respuesta. */
    async function botSays(text: string, replies: QuickReply[], minDelay = 0) {
      const typing = showTyping();
      await sleep(Math.max(minDelay, Math.min(450 + text.length * 9, 1500)));
      typing.remove();
      appendMessage('bot', text);
      renderQuickReplies(replies);
    }

    function repliesFor(result: BotAnswer): QuickReply[] {
      return [...(result.quickReplies ?? []), ...(result.offerWhatsApp ? [waReply] : [])];
    }

    async function respond(userText: string) {
      busy = true;
      clearQuickReplies();
      const local = resolveAnswer(userText);
      if (local) {
        await botSays(local.text, repliesFor(local));
      } else {
        // Sin coincidencia confiable en el guion: consulta la IA (el indicador
        // de "escribiendo" se queda mientras llega la respuesta, mínimo 700ms).
        const typing = showTyping();
        const [aiText] = await Promise.all([askAI(history), sleep(700)]);
        typing.remove();
        if (aiText) {
          appendMessage('bot', aiText);
          renderQuickReplies([waReply]);
        } else {
          appendMessage('bot', FALLBACK);
          renderQuickReplies([waReply]);
        }
      }
      busy = false;
    }

    async function onQuickReply(item: QuickReply) {
      if (item.id === '__whatsapp__') {
        window.open(waLink(lastUserText), '_blank', 'noopener');
        return;
      }
      if (busy) return;
      busy = true;
      clearQuickReplies();
      appendMessage('user', item.label);
      lastUserText = item.label;
      refreshWaHeader();
      const result = getAnswerForTopic(item.id);
      if (result) await botSays(result.text, repliesFor(result));
      busy = false;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const raw = input!.value.trim().slice(0, 500);
      if (!raw || busy) return;
      input!.value = '';
      appendMessage('user', raw);
      lastUserText = raw;
      refreshWaHeader();
      await respond(raw);
    });

    function openChat() {
      isOpen = true;
      win!.hidden = false;
      requestAnimationFrame(() => {
        win!.classList.add('is-open');
        launcher!.classList.add('is-open');
      });
      launcher!.setAttribute('aria-expanded', 'true');
      document.body.classList.add('chatbot-is-open');
      if (!greeted) {
        greeted = true;
        appendMessage('bot', GREETING);
        renderQuickReplies(getRootQuickReplies());
      }
      requestAnimationFrame(() => input!.focus());
    }

    function closeChat() {
      isOpen = false;
      win!.classList.remove('is-open');
      launcher!.classList.remove('is-open');
      launcher!.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('chatbot-is-open');
      const onEnd = () => {
        win!.hidden = true;
        win!.removeEventListener('transitionend', onEnd);
      };
      win!.addEventListener('transitionend', onEnd);
      launcher!.focus();
    }

    launcher.addEventListener('click', () => (isOpen ? closeChat() : openChat()));
    closeBtn.addEventListener('click', closeChat);
    win.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeChat();
    });
  }
</script>
