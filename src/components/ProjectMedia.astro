---
interface Props {
  name: string;
  statusLabel: string;
  video?: string;
  image?: string;
  imageAlt?: string;
}

const { name, statusLabel, video, image, imageAlt } = Astro.props;
---
<span class="status-pill">{statusLabel}</span>
{video && <iframe src={video} allow="autoplay" loading="lazy" title={name} />}
{!video && image && <img src={image} alt={imageAlt ?? name} loading="lazy" />}
